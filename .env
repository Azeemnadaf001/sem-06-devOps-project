- 
+ # Backend Environment Variables
+ PORT=3000
+ NODE_ENV=production
+ LOG_LEVEL=info
+ 
+ # API Settings
+ CORS_ORIGIN=*
+ 
+ # AWS S3 (for future integration)
+ AWS_REGION=ap-south-1
+ AWS_S3_BUCKET=ecommerce-platform-assets
+ 
+ # Database (for future use)
+ DATABASE_URL=postgresql://user:password@db:5432/ecommerce
